# Copy the names into Replit → Secrets (never commit real values). Required ones are marked.

# --- This service ---
DATABASE_URL=                     # required: this service's own Postgres (Replit → Database creates it)
FINANCIER_DB_API_KEYS=            # required: one or more keys (comma-separated, 16+ chars each), e.g. `openssl rand -hex 24`
# PORT=8080
# LOG_LEVEL=info
# SCHEDULER_DISABLED=1            # turn the 15-minute sync off on this instance (e.g. a second copy you only read from)
# ATLAS_READONLY_DATABASE_URL=    # optional: read-only login to Atlas's database (lender ids linked to Atlas projects; import script)

# --- EnFin ---
ENFIN_CLIENT_ID=
ENFIN_CLIENT_SECRET=
ENFIN_USERNAME=
ENFIN_PASSWORD=
# ENFIN_APPLICATION_NUMBERS=      # optional extra CTRTPO-/APPTPO- ids
# ENFIN_API_BASE_URL= ENFIN_OAUTH_TOKEN_URL= ENFIN_PROJECT_INFO_PATH= ENFIN_ORGANIZATION_NAME=

# --- Concert ---
CONCERT_USERNAME=
CONCERT_PASSWORD=
# CONCERT_CLIENT_ID= CONCERT_CLIENT_SECRET= CONCERT_OAUTH_SCOPE= CONCERT_OAUTH_TOKEN_URL= CONCERT_API_BASE_URL=

# --- GoodLeap ---
GOODLEAP_CLIENT_ID=
GOODLEAP_CLIENT_SECRET=
# GOODLEAP_PARTNER_ORG_IDS= GOODLEAP_LOAN_TAGS= GOODLEAP_OAUTH_TOKEN_URL= GOODLEAP_API_BASE_URL=

# --- Palmetto (LightReach) ---
PALMETTO_USERNAME=
PALMETTO_PASSWORD=                # the exact password, including any trailing "#"
# PALMETTO_OAUTH_TOKEN_URL= PALMETTO_API_BASE_URL=

# --- Sunrun ---
SUNRUN_USERNAME=
SUNRUN_PASSWORD=
# SUNRUN_DEAL_IDS= SUNRUN_SANDBOX= SUNRUN_LOGIN_URL= SUNRUN_BASIC_USERNAME= SUNRUN_BASIC_PASSWORD=

# --- Aurora (finds EnFin ids; optional) ---
AURORA_API_TOKEN=
AURORA_TENANT_ID=
# AURORA_API_HOST= AURORA_API_BASE_URL=
