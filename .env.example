# Names for Replit → Secrets (never commit real values).
#
# The minimum is ONE secret: ATLAS_READONLY_DATABASE_URL. DATABASE_URL comes from Replit's Database tool, the API key is
# made by the service (`pnpm api-key`), and every lender without its login here is copied from Atlas (mirror mode).
# Lender logins below are optional: set them only to read that lender directly instead of copying from Atlas.

# --- This service ---
# DATABASE_URL=                   # set by Replit when you add a Database to the Repl
ATLAS_READONLY_DATABASE_URL=      # read-only login to Atlas's database (atlas_analytics): mirror mode, linked ids, import
# FINANCIER_DB_API_KEYS=          # optional: your own key(s), comma-separated, 16+ chars; otherwise the service makes one
# PORT=8080
# LOG_LEVEL=info
# SCHEDULER_DISABLED=1            # turn the 15-minute sync off on this instance

# --- Optional: lender logins for direct mode (same names as Atlas) ---

# --- EnFin ---
# ENFIN_CLIENT_ID=
# ENFIN_CLIENT_SECRET=
# ENFIN_USERNAME=
# ENFIN_PASSWORD=
# ENFIN_APPLICATION_NUMBERS=      # optional extra CTRTPO-/APPTPO- ids
# ENFIN_API_BASE_URL= ENFIN_OAUTH_TOKEN_URL= ENFIN_PROJECT_INFO_PATH= ENFIN_ORGANIZATION_NAME=

# --- Concert ---
# CONCERT_USERNAME=
# CONCERT_PASSWORD=
# CONCERT_CLIENT_ID= CONCERT_CLIENT_SECRET= CONCERT_OAUTH_SCOPE= CONCERT_OAUTH_TOKEN_URL= CONCERT_API_BASE_URL=

# --- GoodLeap ---
# GOODLEAP_CLIENT_ID=
# GOODLEAP_CLIENT_SECRET=
# GOODLEAP_PARTNER_ORG_IDS= GOODLEAP_LOAN_TAGS= GOODLEAP_OAUTH_TOKEN_URL= GOODLEAP_API_BASE_URL=

# --- Palmetto (LightReach) ---
# PALMETTO_USERNAME=
# PALMETTO_PASSWORD=              # the exact password, including any trailing "#"
# PALMETTO_OAUTH_TOKEN_URL= PALMETTO_API_BASE_URL=

# --- Sunrun ---
# SUNRUN_USERNAME=
# SUNRUN_PASSWORD=
# SUNRUN_DEAL_IDS= SUNRUN_SANDBOX= SUNRUN_LOGIN_URL= SUNRUN_BASIC_USERNAME= SUNRUN_BASIC_PASSWORD=

# --- Aurora (finds EnFin ids; optional) ---
# AURORA_API_TOKEN=
# AURORA_TENANT_ID=
# AURORA_API_HOST= AURORA_API_BASE_URL=
