modules = ["nodejs-24", "postgresql-16"]
run = "pnpm install && pnpm run dev"

[deployment]
# Reserved VM, not Autoscale: the 15-minute sync runs inside the server, and Autoscale stops the process when no
# request is coming in.
deploymentTarget = "vm"
build = ["sh", "-c", "pnpm install --frozen-lockfile && pnpm run build"]
run = ["sh", "-c", "pnpm start"]

[[ports]]
localPort = 8080
externalPort = 80

[workflows]
runButton = "Server"

[[workflows.workflow]]
name = "Server"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm install && pnpm run dev"
waitForPort = 8080

[[workflows.workflow]]
name = "Tests"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm install && pnpm run typecheck && pnpm test"
